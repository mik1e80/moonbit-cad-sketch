----
import {
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----
// Repository-authored registry consumer verification; Apache-2.0.
// args: source-root fresh-outside-workspace receipt-path
async fn run(project : String, log : String, args : Array[String]) -> String {
  let result = @shell.Cmd("moon", args, cwd=project).output(timeout_ms=600000, max_output_bytes=16777216)
  @fs.write_file(log + ".stdout.log", result.stdout())
  @fs.write_file(log + ".stderr.log", result.stderr())
  guard result.exit_code() == 0 else { println(result.stderr()); fail("Consumer command failed; logs retained") }
  println("Passed moon " + args.join(" "))
  result.stdout()
}
async fn main {
 let args = @env.args()
 let source = args[1]
 let workspace = args[2]
 let receipt_path = args[3]
 guard !workspace.has_prefix(source) && !@fs.exists(workspace) else { fail("Consumer workspace must be fresh and outside source") }
 @fs.mkdir(workspace, recursive=true)
 run(workspace, workspace + "/new", ["new", "consumer", "--user", "audit"]) |> ignore
 let project = workspace + "/consumer"
 guard !@fs.exists(project + "/moon.work") && !@fs.exists(project + "/.mooncakes") else { fail("Expected independent fresh project") }
 let installed = run(project, workspace + "/install", ["add", "mik1e80/cad_sketch@0.4.0"])
 guard !installed.contains("failed to update registry index") else { fail("Registry index refresh failed") }
 let manifest = @fs.read_file(project + "/moon.mod").text()
 guard manifest.contains("mik1e80/cad_sketch@0.4.0") && !manifest.contains("path") else { fail("Registry version did not match") }
 let downloaded = @fs.read_file(project + "/.mooncakes/mik1e80/cad_sketch/moon.mod").text()
 guard downloaded.contains("version = \"0.4.0\"") else { fail("Downloaded wrong module version") }
 @fs.write_file(project + "/moon.pkg", "import { \"mik1e80/cad_sketch\" @sketch, \"moonbitlang/core/math\", }\n")
 @fs.write_file(project + "/consumer.mbt", "")
 @fs.write_file(project + "/consumer_test.mbt", "")
 let files = ["arc_test.mbt", "arc_boundaries_test.mbt", "arc_relations_test.mbt", "arc_scale_test.mbt", "geometry_edit_test.mbt", "diagnostics_analysis_test.mbt"]
 for file in files { @fs.write_file(project + "/" + file, @fs.read_file(source + "/" + file)) }
 @fs.write_file(project + "/LICENSE", @fs.read_file(source + "/LICENSE"))
 @fs.write_file(project + "/cmd/main/moon.pkg", "import { \"mik1e80/cad_sketch\" @sketch, }\noptions(\"is-main\":true)\n")
 @fs.write_file(project + "/cmd/main/main.mbt", @fs.read_file(source + "/examples/arc_fillet/main.mbt"))
 run(project, workspace + "/check", ["check", "--target", "all", "--deny-warn"]) |> ignore
 for target in ["wasm", "wasm-gc", "js", "native"] {
  let out = run(project, workspace + "/tests-" + target, ["test", "--target", target, "--deny-warn"])
  guard out.contains("Total tests: 22, passed: 22, failed: 0.") else { println(out); fail("Unexpected consumer test total") }
 }
 let display = run(project, workspace + "/run", ["run", "cmd/main", "--target", "js", "--deny-warn"])
 guard display.contains("Arc showcase verified:") && display.contains("<path data-arc=") else { fail("Consumer arc executable did not verify") }
 let receipt : Json = {
  "schema":1, "date":"2026-11-17", "module":"mik1e80/cad_sketch", "version":"0.4.0",
  "source":"Mooncakes registry", "outside_repository":true, "fresh_project_created_with_moon_new":true,
  "workspace_or_path_override":false, "targets":["wasm","wasm-gc","js","native"],
  "public_consumer_tests_per_backend":22, "generated_configurations_per_backend":480,
  "source_tests_copied":files, "arc_editing_executable_verified":true,
  "scope":"Copied public black-box tests only; no solver source copied, no third-party adoption claim",
  "raw_logs":workspace,
 }
 @fs.write_file(receipt_path, receipt.stringify(indent=2) + "\n")
 println("Registry 0.4.0 completeness consumer passed")
}

